{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": ["@typescript/native"],
  "workspaces": {
    ".": {
      "ignoreDependencies": ["@types/pg", "execa", "kysely", "@nous-wave/client"],
      "entry": [
        "scripts/**/*.mjs",
        "integration/foundation/vitest.config.ts",
        "integration/foundation/test/**/*.integration.test.ts"
      ],
      "project": ["scripts/**/*.mjs", "integration/foundation/**/*.ts"]
    },
    "packages/*/*": {
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/application/cli": {
      "entry": ["src/index.ts", "src/bin.ts", "src/commands/**/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/application/management-client": {
      "entry": [
        "src/index.ts",
        "src/node.ts",
        "src/generated/**/*.ts",
        "scripts/generate.mjs"
      ],
      "project": ["src/**/*.ts"]
    },
    "packages/application/product-host": {
      "entry": ["src/index.ts", "src/bin.ts", "scripts/**/*.mjs"],
      "project": ["src/**/*.ts", "scripts/**/*.mjs"]
    },
    "packages/product/messaging": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/product/subject": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/system/management": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/foundation/schema-runtime": {
      "entry": ["src/index.ts", "src/typebox.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "tools/*": {
      "entry": ["test/fixtures/**/*.mjs"],
      "project": ["src/**/*.mjs", "test/**/*.mjs"]
    },
    "packages/data/persistence": {
      "entry": ["src/repository.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/execution/durable-execution": {
      "project": ["src/**/*.ts", "test/**/*.ts"],
      "ignoreDependencies": ["^@dbos-inc/dbos-sdk$"]
    },
    "packages/application/openclaw-host": {
      "entry": ["src/index.ts", "scripts/**/*.mjs", "test/support/*.mjs"],
      "project": [
        "src/**/*.ts",
        "scripts/**/*.mjs",
        "test/**/*.ts",
        "test/support/*.mjs"
      ],
      "ignoreDependencies": ["ajv", "typebox"]
    }
  }
}
