{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "repo-kit",
  "projectType": "library",
  "tags": ["kind:tooling", "area:repository"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "oxlint --type-aware tools/repo-kit"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --root tools/repo-kit"
      },
      "dependsOn": [
        {
          "projects": "repository",
          "target": "build"
        }
      ]
    }
  }
}
