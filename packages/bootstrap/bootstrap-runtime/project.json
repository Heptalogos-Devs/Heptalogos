{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "bootstrap-runtime",
  "projectType": "library",
  "tags": ["kind:product", "area:bootstrap"],
  "sourceRoot": "packages/bootstrap/bootstrap-runtime/src",
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "oxlint --type-aware packages/bootstrap/bootstrap-runtime"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --root packages/bootstrap/bootstrap-runtime --exclude **/*.integration.test.ts"
      }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --root packages/bootstrap/bootstrap-runtime test/integration/bootstrap-recovery-process.integration.test.ts test/integration/bootstrap-recovery-process.postgres.integration.test.ts"
      }
    },
    "test:recovery-process": {
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --root packages/bootstrap/bootstrap-runtime test/integration/bootstrap-recovery-process.integration.test.ts"
      }
    },
    "test:recovery-process:postgres": {
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --root packages/bootstrap/bootstrap-runtime test/integration/bootstrap-recovery-process.postgres.integration.test.ts"
      }
    }
  }
}
