{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "rootDir": ".",
    "outDir": "./dist/types",
    "tsBuildInfoFile": "./dist/types/tsconfig.tsbuildinfo",
    "types": ["node", "ws", "vitest/globals"],
    "lib": ["ES2025", "DOM", "DOM.Iterable"],
    "paths": {
      "ws": ["./node_modules/@types/ws/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "references": [
    {
      "path": "../management-client"
    },
    {
      "path": "../../product/messaging"
    },
    {
      "path": "../../foundation/schema-runtime"
    }
  ]
}
