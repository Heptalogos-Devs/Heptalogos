{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "rootDir": "src",
    "outDir": "./dist",
    "types": ["node", "ws"],
    "tsBuildInfoFile": "./dist/tsconfig.build.tsbuildinfo",
    "lib": ["ES2025", "DOM", "DOM.Iterable"],
    "paths": {
      "ws": ["./node_modules/@types/ws/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["test/**/*.ts"],
  "references": [
    {
      "path": "../management-client/tsconfig.build.json"
    },
    {
      "path": "../../product/messaging/tsconfig.build.json"
    },
    {
      "path": "../../foundation/schema-runtime/tsconfig.build.json"
    }
  ]
}
