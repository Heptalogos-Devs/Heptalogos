{
  "id": "heptalogos-qq",
  "name": "Heptalogos QQ",
  "description": "Host-governed first-party QQ channel",
  "version": "0.1.0",
  "channels": [
    "heptalogos-qq"
  ],
  "configSchema": {
    "type": "object",
    "required": [
      "connectionFile",
      "hostOrigin",
      "serviceTokenFile",
      "mediaTempRoot",
      "napcatExportRoots",
      "requestTimeoutMs",
      "reconnectMinMs",
      "reconnectMaxMs",
      "maxTextBytes",
      "mediaMaxBytes",
      "mediaConcurrency",
      "mediaDailyBytes",
      "forwardMaxDepth",
      "forwardMaxNodes",
      "forwardMaxBytes",
      "forwardMaxRequests",
      "historyPageSize",
      "historyMaxPages"
    ],
    "properties": {
      "connectionFile": {
        "type": "string",
        "minLength": 1
      },
      "hostOrigin": {
        "type": "string",
        "pattern": "^http://127\\.0\\.0\\.1:[0-9]+/?$"
      },
      "serviceTokenFile": {
        "type": "string",
        "minLength": 1
      },
      "mediaTempRoot": {
        "type": "string",
        "minLength": 1
      },
      "napcatExportRoots": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "maxItems": 16
      },
      "requestTimeoutMs": {
        "type": "integer",
        "minimum": 100,
        "maximum": 60000
      },
      "reconnectMinMs": {
        "type": "integer",
        "minimum": 10,
        "maximum": 60000
      },
      "reconnectMaxMs": {
        "type": "integer",
        "minimum": 10,
        "maximum": 300000
      },
      "maxTextBytes": {
        "type": "integer",
        "minimum": 1,
        "maximum": 65536
      },
      "mediaMaxBytes": {
        "type": "integer",
        "minimum": 1,
        "maximum": 67108864
      },
      "mediaConcurrency": {
        "type": "integer",
        "minimum": 1,
        "maximum": 8
      },
      "mediaDailyBytes": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10737418240
      },
      "mediaAllowFakeIpDns": {
        "type": "boolean"
      },
      "forwardMaxDepth": {
        "type": "integer",
        "minimum": 0,
        "maximum": 32
      },
      "forwardMaxNodes": {
        "type": "integer",
        "minimum": 1,
        "maximum": 4096
      },
      "forwardMaxBytes": {
        "type": "integer",
        "minimum": 1,
        "maximum": 4194304
      },
      "forwardMaxRequests": {
        "type": "integer",
        "minimum": 0,
        "maximum": 32
      },
      "historyPageSize": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      },
      "historyMaxPages": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      }
    },
    "additionalProperties": false
  }
}
