{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "openclaw-host",
  "projectType": "library",
  "tags": ["kind:product", "area:application"],
  "sourceRoot": "packages/application/openclaw-host/src",
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "oxlint --type-aware packages/application/openclaw-host"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --root packages/application/openclaw-host"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "pnpm exec tsc --build packages/application/openclaw-host/tsconfig.build.json && node packages/application/openclaw-host/scripts/bundle.mjs"
      }
    },
    "pack": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node packages/application/openclaw-host/scripts/pack.mjs"
      }
    }
  }
}
