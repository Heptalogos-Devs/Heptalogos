{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "management-client",
  "projectType": "library",
  "tags": ["kind:product", "area:client"],
  "sourceRoot": "packages/application/management-client/src",
  "targets": {
    "generate": {
      "dependsOn": [
        {
          "projects": "product-host",
          "target": "generate:openapi"
        }
      ],
      "executor": "nx:run-commands",
      "options": {
        "command": "node packages/application/management-client/scripts/generate.mjs"
      }
    },
    "generate:check": {
      "dependsOn": [
        {
          "projects": "product-host",
          "target": "check:openapi"
        }
      ],
      "executor": "nx:run-commands",
      "options": {
        "command": "node packages/application/management-client/scripts/generate.mjs --check"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "oxlint --type-aware --ignore-pattern \"**/src/generated/**\" packages/application/management-client"
      }
    }
  }
}
