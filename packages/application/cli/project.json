{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "cli",
  "projectType": "application",
  "tags": ["kind:product", "area:client"],
  "sourceRoot": "packages/application/cli/src",
  "targets": {
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/pnpm-workspace.yaml",
        "{workspaceRoot}/package.json",
        {
          "runtime": "node -e \"try{console.log('pnpm major '+require('child_process').execFileSync('pnpm',['--version'],{stdio:['ignore','pipe','ignore']}).toString().trim().split('.')[0])}catch{console.log('pnpm major unavailable')}\""
        }
      ],
      "outputs": [
        "{projectRoot}/dist/package.json",
        "{projectRoot}/dist/pnpm-lock.yaml",
        "{projectRoot}/dist/pnpm-workspace.yaml",
        "{projectRoot}/dist/patches",
        "{projectRoot}/dist/local_path_modules"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:copy-workspace-modules",
      "outputs": ["{projectRoot}/dist/workspace_modules"],
      "options": {
        "buildTarget": "build"
      },
      "inputs": ["default", "^default"]
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/package/normalize-cli-artifact.mjs"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "oxlint --type-aware packages/application/cli"
      }
    }
  }
}
