{
  "$schema": "./node_modules/nx/schemas/project-schema.json",
  "name": "repository",
  "projectType": "library",
  "tags": ["kind:tooling", "area:repository"],
  "implicitDependencies": [
    "foundation-contracts",
    "management-client",
    "bootstrap-runtime",
    "durable-execution",
    "execution-lineage",
    "effect-operation",
    "private-postgres",
    "bootstrap-state",
    "runtime-substrate",
    "schema-runtime",
    "host-ownership",
    "product-host",
    "time-service",
    "runtime-kernel",
    "canonical-schema",
    "network-access",
    "configuration",
    "os-credential",
    "work-queue",
    "evidence",
    "ai-runtime",
    "management",
    "messaging",
    "persistence",
    "signal",
    "cli",
    "product-host-integration",
    "subject",
    "secret",
    "repo-kit",
    "openclaw-host"
  ],
  "targets": {
    "check:agents": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/verify/agents.mjs"
      }
    },
    "check:knowledge": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/verify/knowledge.mjs"
      }
    },
    "check:repository": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/verify/repository.mjs"
      }
    },
    "check:package-layout": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/verify/package-layout.mjs"
      }
    },
    "check:hygiene": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/verify/current-tree-hygiene.mjs"
      }
    },
    "check:dependencies": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/verify/dependencies.mjs"
      }
    },
    "check:boundaries": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/verify/boundaries.mjs"
      }
    },
    "docs:api": {
      "dependsOn": ["build"],
      "parallelism": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/verify/api-docs.mjs --write"
      }
    },
    "docs:api:check": {
      "dependsOn": ["build"],
      "parallelism": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/verify/api-docs.mjs"
      }
    },
    "check:product-artifacts": {
      "dependsOn": [
        {
          "projects": "product-host",
          "target": "check:build-identities"
        },
        {
          "projects": "management-client",
          "target": "generate:check"
        }
      ],
      "executor": "nx:noop"
    },
    "check:unused": {
      "executor": "nx:run-commands",
      "options": {
        "command": "knip"
      }
    },
    "toolchain:check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/verify/toolchain.mjs"
      }
    },
    "check:duplicates": {
      "executor": "nx:run-commands",
      "options": {
        "command": "jscpd --config .jscpd.json packages integration tools scripts .agents"
      }
    },
    "format:check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prettier --check --cache --cache-location .nx/prettier-cache ."
      }
    },
    "boundary": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint packages integration tools scripts"
      },
      "dependsOn": ["prepare:native-sdk"]
    },
    "source-docs:lint": {
      "dependsOn": ["boundary"],
      "executor": "nx:noop"
    },
    "tooling:lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "oxlint --type-aware .agents scripts tools eslint.config.mjs"
      }
    },
    "schema:lint": {
      "dependsOn": ["typecheck"],
      "executor": "nx:run-commands",
      "options": {
        "command": "oxlint --type-aware --config .oxlintrc-schema-owner.json packages"
      }
    },
    "lint": {
      "dependsOn": ["^lint", "boundary", "tooling:lint", "schema:lint"],
      "executor": "nx:noop"
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "executor": "nx:noop"
    },
    "tsc6": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc6 --noEmit -p tsconfig.ts6.json"
      }
    },
    "test": {
      "dependsOn": [
        "^test",
        {
          "projects": "integration-foundation",
          "target": "test"
        }
      ],
      "executor": "nx:noop"
    },
    "build": {
      "dependsOn": ["^build"],
      "executor": "nx:noop"
    },
    "check:repo": {
      "dependsOn": [
        "check:agents",
        "check:knowledge",
        "check:repository",
        "check:package-layout",
        "check:hygiene",
        "check:dependencies",
        "check:boundaries",
        "check:duplicates",
        "check:unused",
        "toolchain:check",
        "docs:api:check",
        "check:product-artifacts",
        "tsc6"
      ],
      "executor": "nx:run-commands",
      "options": {
        "command": "node -e \"process.exit(0)\""
      }
    },
    "check:static": {
      "dependsOn": [
        "check:duplicates",
        "format:check",
        "check:product-artifacts",
        "source-docs:lint",
        "lint",
        "typecheck",
        "check:boundaries",
        "check:unused"
      ],
      "executor": "nx:run-commands",
      "options": {
        "command": "node -e \"process.exit(0)\""
      }
    },
    "verify": {
      "dependsOn": ["check:static", "^test", "^build"],
      "executor": "nx:noop"
    },
    "prepare:native-sdk": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/package/prepare-native-sdk.mjs"
      }
    }
  }
}
