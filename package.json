{
  "name": "heptalogos",
  "version": "0.2.0-infrastructure.1",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.check.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "format": "biome format --write apps packages integrations tests scripts",
    "verify": "pnpm typecheck && pnpm test && pnpm build",
    "hept": "node apps/cli/dist/bin.js",
    "serve": "node apps/server/dist/index.js",
    "generate": "tsx scripts/generate.ts",
    "clean": "tsc -b --clean",
    "pack:packages": "pnpm -r --filter \"./packages/**\" --filter \"./apps/**\" --filter \"./integrations/**\" pack"
  },
  "dependencies": {
    "@heptalogos/hept": "workspace:*",
    "@heptalogos/contracts": "workspace:*",
    "@heptalogos/client": "workspace:*",
    "@heptalogos/cli": "workspace:*",
    "@heptalogos/server": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/cacache": "19.0.0",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "@dbos-inc/dbos-sdk": "5.3.0",
    "uuid": "14.0.2",
    "@nous-wave/platform": "0.2.0-infrastructure.1",
    "@nous-wave/contracts": "0.2.0-infrastructure.1"
  }
}
