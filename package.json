{
  "name": "heptalogos",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "24.20.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check --cache --cache-location .nx/prettier-cache .",
    "lint": "node scripts/verify/run-nx.mjs run repository:lint",
    "typecheck": "node scripts/verify/run-nx.mjs run repository:typecheck",
    "tsc6": "tsc6 --noEmit -p tsconfig.ts6.json",
    "test": "node scripts/verify/run-nx.mjs run repository:test",
    "build": "node scripts/verify/run-nx.mjs run repository:build",
    "nx:check": "nx --version",
    "check:agents": "node scripts/verify/agents.mjs",
    "check:knowledge": "node scripts/verify/knowledge.mjs",
    "check:repository": "node scripts/verify/repository.mjs",
    "check:package-layout": "node scripts/verify/package-layout.mjs",
    "check:hygiene": "node scripts/verify/current-tree-hygiene.mjs",
    "check:dependencies": "node scripts/verify/dependencies.mjs",
    "check:boundaries": "node scripts/verify/boundaries.mjs",
    "docs:api": "nx run repository:docs:api",
    "docs:api:check": "nx run repository:docs:api:check",
    "check:product-artifacts": "nx run repository:check:product-artifacts",
    "check:unused": "knip",
    "check:duplicates": "nx run repository:check:duplicates",
    "toolchain:check": "node scripts/verify/toolchain.mjs",
    "verify": "node scripts/verify/run-nx.mjs run repository:verify",
    "check:static": "node scripts/verify/run-nx.mjs run repository:check:static",
    "check:repo": "node scripts/verify/run-nx.mjs run repository:check:repo",
    "clean": "node scripts/maintenance/clean.mjs",
    "package:portable": "node scripts/package/assemble-portable-product.mjs",
    "qualify:portable": "node scripts/verify/run-nx.mjs run product-host-integration:qualify-portable"
  },
  "nx": {
    "includedScripts": []
  },
  "devDependencies": {
    "@heptalogos/repo-kit": "workspace:*",
    "@nx/eslint-plugin": "catalog:",
    "@nx/js": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-jsdoc": "catalog:",
    "jscpd": "catalog:",
    "knip": "catalog:",
    "nx": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "prettier": "catalog:",
    "typedoc": "catalog:",
    "typedoc-plugin-markdown": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
